# =============================================================================
# AARAN AI — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Keys here are server-side only — see lib/ai/provider.ts.
# =============================================================================

# --- Demo Mode ------------------------------------------------------------
# When true, the app runs entirely on the 3 built-in sample companies.
# No API keys or internet access are required. This is the safe default
# for live presentations — flip to false only once real keys are set below.
DEMO_MODE=true

# --- AI Provider ------------------------------------------------------------
# Anthropic is the primary provider (see lib/ai/anthropic.ts).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which model the agents call. Claude Sonnet is the default: strong reasoning
# at reasonable cost for a 15-agent pipeline.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional future providers (the app supports switching via AI_PROVIDER,
# but only "anthropic" and "demo" are implemented today).
# AI_PROVIDER=anthropic
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Web Search ---------------------------------------------------------
# ResearchAgent, FounderAgent, and TractionAgent use Claude's own hosted
# web_search tool to look up facts not in the model's training data. This
# is NOT a separate service or key — it's billed through ANTHROPIC_API_KEY
# above, and only runs when DEMO_MODE=false. See lib/ai/anthropic.ts.

# --- Supabase (optional persistence) ----------------------------------------
# Without these, saved research is stored in the browser (localStorage) only.
# Set both to enable shared/persistent storage. See supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
