# =============================================================================
# AARAN AI — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Keys here are server-side only — see lib/ai/provider.ts.
# =============================================================================

# --- Demo Mode ------------------------------------------------------------
# When true, the app runs entirely on the 3 built-in sample companies.
# No API keys or internet access are required. This is the safe default
# for live presentations — flip to false only once real keys are set below.
DEMO_MODE=true

# --- AI Provider ------------------------------------------------------------
# Anthropic is the primary provider (see lib/ai/anthropic.ts).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which model the agents call. Claude Sonnet is the default: strong reasoning
# at reasonable cost for a 15-agent pipeline.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional future providers (the app supports switching via AI_PROVIDER,
# but only "anthropic" and "demo" are implemented today).
# AI_PROVIDER=anthropic
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Web Search ---------------------------------------------------------
# ResearchAgent, FounderAgent, and TractionAgent use Claude's own hosted
# web_search tool to look up facts not in the model's training data. This
# is NOT a separate service or key — it's billed through ANTHROPIC_API_KEY
# above, and only runs when DEMO_MODE=false. See lib/ai/anthropic.ts.

# --- Supabase (optional persistence) ----------------------------------------
# Without these, saved research is stored in the browser (localStorage) only.
# Set both to enable shared/persistent storage. See supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public Equity Engine (Analyze Company) ---------------------------------
# SEC EDGAR is free and needs no API key, but the SEC requires every request
# to identify a real contact per https://www.sec.gov/os/webmaster-faq#developers.
# Set this to "YourAppName your-email@example.com" — a generic default is
# used otherwise. See lib/data/sec-edgar.ts.
SEC_EDGAR_USER_AGENT=

# Market quotes (current price) use Stooq's free end-of-day CSV feed — no key
# needed. See lib/data/market-data.ts. If Stooq is unreachable, the app shows
# "DATA NOT AVAILABLE" for price rather than guessing one.

# Institutional ownership (13F "Smart Money" holders) is NOT wired to a real
# provider yet — it needs a licensed feed such as Financial Modeling Prep,
# WhaleWisdom, or Fintel (roughly $15-30/mo). Until one is connected, the
# Smart Money section honestly shows "DATA NOT AVAILABLE" in live mode. See
# lib/data/institutional-intelligence.ts for exactly where to wire one in.
# INSTITUTIONAL_DATA_PROVIDER=
# INSTITUTIONAL_DATA_PROVIDER_API_KEY=

# Real-time analyst-consensus price targets/ratings are similarly not
# connected — the Valuation Engine's "analyst consensus" field is always
# marked UNVERIFIED until a licensed consensus feed is added.
